{
  "description": "Krea 2 Turbo. Loads its diffusion model, a Qwen3-VL text encoder and the Qwen image VAE.",
  "media": "image",
  "defaults": {
    "prompt": "a surreal digital illustration of a hand holding a martini glass, high resolution",
    "width": 1024,
    "height": 1024,
    "steps": 8,
    "cfg": 1,
    "seed": 42
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": { "unet_name": "model.safetensors", "weight_dtype": "default" }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": { "clip_name": "text_encoder.safetensors", "type": "krea2", "device": "default" }
    },
    "3": { "class_type": "VAELoader", "inputs": { "vae_name": "vae.safetensors" } },
    "4": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{prompt}}", "clip": ["2", 0] } },
    "5": { "class_type": "ConditioningZeroOut", "inputs": { "conditioning": ["4", 0] } },
    "6": {
      "class_type": "EmptyLatentImage",
      "inputs": { "width": "{{width}}", "height": "{{height}}", "batch_size": 1 }
    },
    "7": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0],
        "positive": ["4", 0],
        "negative": ["5", 0],
        "latent_image": ["6", 0],
        "seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg}}",
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1
      }
    },
    "8": { "class_type": "VAEDecode", "inputs": { "samples": ["7", 0], "vae": ["3", 0] } },
    "9": { "class_type": "SaveImage", "inputs": { "filename_prefix": "runpod", "images": ["8", 0] } }
  }
}
