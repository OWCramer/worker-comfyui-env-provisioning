{
  "description": "Single-file checkpoint: Stable Diffusion 1.5, SDXL and their fine-tunes.",
  "media": "image",
  "defaults": {
    "prompt": "a lighthouse on a granite cliff at sunrise, oil painting, thick brushwork",
    "negative_prompt": "blurry, low quality, watermark, text",
    "width": 1024,
    "height": 1024,
    "steps": 25,
    "cfg": 7,
    "sampler_name": "euler",
    "scheduler": "normal",
    "seed": 42
  },
  "graph": {
    "1": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "model.safetensors" } },
    "2": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{prompt}}", "clip": ["1", 1] } },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "{{negative_prompt}}", "clip": ["1", 1] }
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "inputs": { "width": "{{width}}", "height": "{{height}}", "batch_size": 1 }
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0],
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["4", 0],
        "seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg}}",
        "sampler_name": "{{sampler_name}}",
        "scheduler": "{{scheduler}}",
        "denoise": 1
      }
    },
    "6": { "class_type": "VAEDecode", "inputs": { "samples": ["5", 0], "vae": ["1", 2] } },
    "7": { "class_type": "SaveImage", "inputs": { "filename_prefix": "runpod", "images": ["6", 0] } }
  }
}
