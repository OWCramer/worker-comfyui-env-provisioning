{
  "description": "Qwen-Image. Loads its diffusion model, the Qwen2.5-VL text encoder and its own VAE.",
  "media": "image",
  "defaults": {
    "prompt": "a warm neon-lit street scene in Hong Kong in the afternoon, colourful signage, cinematic",
    "negative_prompt": "",
    "width": 1328,
    "height": 1328,
    "steps": 20,
    "cfg": 4,
    "shift": 3.1,
    "seed": 42
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": { "unet_name": "model.safetensors", "weight_dtype": "default" }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "text_encoder.safetensors",
        "type": "qwen_image",
        "device": "default"
      }
    },
    "3": { "class_type": "VAELoader", "inputs": { "vae_name": "vae.safetensors" } },
    "4": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": { "model": ["1", 0], "shift": "{{shift}}" }
    },
    "5": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{prompt}}", "clip": ["2", 0] } },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "{{negative_prompt}}", "clip": ["2", 0] }
    },
    "7": {
      "class_type": "EmptySD3LatentImage",
      "inputs": { "width": "{{width}}", "height": "{{height}}", "batch_size": 1 }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["4", 0],
        "positive": ["5", 0],
        "negative": ["6", 0],
        "latent_image": ["7", 0],
        "seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg}}",
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1
      }
    },
    "9": { "class_type": "VAEDecode", "inputs": { "samples": ["8", 0], "vae": ["3", 0] } },
    "10": { "class_type": "SaveImage", "inputs": { "filename_prefix": "runpod", "images": ["9", 0] } }
  }
}
