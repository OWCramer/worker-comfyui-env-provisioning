{
  "description": "Wan 2.2 TI2V text-to-video. Loads its diffusion model, umt5 text encoder and VAE separately.",
  "media": "video",
  "defaults": {
    "prompt": "a street musician plays guitar in a dim 1970s subway station, warm light spilling across the tiles, camera drifts slowly to the left",
    "negative_prompt": "overexposed, static, blurred details, subtitles, still image, grayish, worst quality, low quality, JPEG artifacts, deformed limbs, fused fingers, cluttered background",
    "width": 1280,
    "height": 704,
    "length": 49,
    "fps": 24,
    "steps": 20,
    "cfg": 5,
    "shift": 8,
    "seed": 42
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": { "unet_name": "model.safetensors", "weight_dtype": "default" }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": { "clip_name": "text_encoder.safetensors", "type": "wan", "device": "default" }
    },
    "3": { "class_type": "VAELoader", "inputs": { "vae_name": "vae.safetensors" } },
    "4": { "class_type": "ModelSamplingSD3", "inputs": { "model": ["1", 0], "shift": "{{shift}}" } },
    "5": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{prompt}}", "clip": ["2", 0] } },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "{{negative_prompt}}", "clip": ["2", 0] }
    },
    "7": {
      "class_type": "Wan22ImageToVideoLatent",
      "inputs": {
        "vae": ["3", 0],
        "width": "{{width}}",
        "height": "{{height}}",
        "length": "{{length}}",
        "batch_size": 1
      }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["4", 0],
        "positive": ["5", 0],
        "negative": ["6", 0],
        "latent_image": ["7", 0],
        "seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg}}",
        "sampler_name": "uni_pc",
        "scheduler": "simple",
        "denoise": 1
      }
    },
    "9": { "class_type": "VAEDecode", "inputs": { "samples": ["8", 0], "vae": ["3", 0] } },
    "10": { "class_type": "CreateVideo", "inputs": { "images": ["9", 0], "fps": "{{fps}}" } },
    "11": {
      "class_type": "SaveVideo",
      "inputs": { "video": ["10", 0], "filename_prefix": "runpod", "format": "auto", "codec": "auto" }
    }
  }
}
